+
+void Fast3dGui::LoadTextureFromEncodedImage(const std::string& name, const uint8_t* imageData, size_t imageDataSize) {
+    if (imageData == nullptr || imageDataSize == 0 ||
+        imageDataSize > static_cast<size_t>(std::numeric_limits<int>::max())) {
+        SPDLOG_WARN("Could not decode GUI texture {}: invalid encoded image data", name);
+        return;
+    }
+
+    int width = 0;
+    int height = 0;
+    int channels = 0;
+    uint8_t* pixels = stbi_load_from_memory(imageData, static_cast<int>(imageDataSize), &width, &height, &channels, 4);
+    if (pixels == nullptr || width <= 0 || height <= 0) {
+        if (pixels != nullptr) {
+            stbi_image_free(pixels);
+        }
+        SPDLOG_WARN("Could not decode GUI texture {}: {}", name, stbi_failure_reason());
+        return;
+    }
+
+    LoadTextureFromDecodedImage(name, pixels, width, height);
+}
+
+void Fast3dGui::LoadTextureFromDecodedImage(const std::string& name, uint8_t* pixels, int width, int height) {
+    auto guiTexture = std::make_shared<Ship::GuiTexture>();
+    guiTexture->Data = pixels;
+    guiTexture->DataSize = static_cast<size_t>(width) * static_cast<size_t>(height) * 4;
+    guiTexture->Metadata.Width = width;
+    guiTexture->Metadata.Height = height;
 
     LoadTextureFromResource(name, guiTexture);
 }
 
 void Fast3dGui::LoadTextureFromResource(const std::string& name, std::shared_ptr<Ship::GuiTexture> texture) {
-    GfxRenderingAPI* api = mInterpreter.lock()->GetCurrentRenderingAPI();
+    if (texture == nullptr || texture->Data == nullptr || texture->Metadata.Width <= 0 ||
+        texture->Metadata.Height <= 0) {
+        SPDLOG_WARN("Skipping invalid GUI texture {}", name);
+        return;
+    }
+
+    const auto interpreter = mInterpreter.lock();
+    if (interpreter == nullptr) {
+        SPDLOG_WARN("Could not load GUI texture {} because the graphics interpreter is unavailable", name);
+        return;
+    }
+    GfxRenderingAPI* api = interpreter->GetCurrentRenderingAPI();
+    if (api == nullptr) {
+        SPDLOG_WARN("Could not load GUI texture {} because the rendering API is unavailable", name);
+        return;
+    }
 
     // TODO: Nothing ever unloads the texture from Fast3D here.
     texture->Metadata.RendererTextureId = api->NewTexture();
